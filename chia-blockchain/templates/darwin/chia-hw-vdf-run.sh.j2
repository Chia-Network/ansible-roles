#!/bin/zsh
# Managed by the chia-blockchain Ansible role.
# hw_vdf_client for one Chia VDF ASIC board (Homebrew chiavdf).
# Linux systemd passes a shorter argv (threads, freq, optional auto-freq/max-freq, mask, ip, port, n_vdfs).
# Darwin adds voltage, retain-asic-values, checkpoint-threshold, and expected-serial.
# Defaults below are overridden by hw-vdf.env when that file is readable.
# The FTDI D2XX driver is not installed by this role; the board will not enumerate without it.
. "{{ chia_darwin_env_script }}"

FREQ='{{ chia_darwin_hw_vdf_freq }}'
VOLTAGE='{{ chia_darwin_hw_vdf_voltage }}'
VDF_THREADS='{{ chia_darwin_hw_vdf_vdf_threads }}'
PROOF_THREADS='{{ chia_darwin_hw_vdf_proof_threads }}'
CHECKPOINT_THRESHOLD='{{ chia_darwin_hw_vdf_checkpoint_threshold }}'
VDFS_MASK='{{ chia_darwin_hw_vdf_mask }}'
N_VDFS='{{ chia_darwin_hw_num_vdfs }}'
SERIAL='{{ chia_darwin_hw_vdf_expected_serial }}'
IP='{{ chia_darwin_hw_vdf_ip }}'
PORT='{{ chia_darwin_hw_vdf_port }}'
RETAIN_ASIC_VALUES='{{ 1 if (chia_darwin_hw_vdf_retain_asic_values | bool) else 0 }}'
HW_VDF_ENV="{{ chia_darwin_etc_dir }}/hw-vdf.env"
[ -r "$HW_VDF_ENV" ] && . "$HW_VDF_ENV"

wait_for_db_volume
wait_for_listen "$PORT"   # timelord vdf_server must be up (hw_vdf_client exits if it can't connect)
sleep {{ chia_darwin_hw_vdf_settle_seconds | int }}

LOG="{{ chia_darwin_log_dir }}/hw-vdf.log"
log "starting hw_vdf_client freq=$FREQ voltage=$VOLTAGE vdf-threads=$VDF_THREADS proof-threads=$PROOF_THREADS mask=$VDFS_MASK serial=$SERIAL -> $IP:$PORT x$N_VDFS" >> "$LOG"

cmd=("{{ chia_darwin_hw_vdf_client }}" --freq "$FREQ")
[ -n "$VOLTAGE" ] && cmd+=(--voltage "$VOLTAGE")
cmd+=(--vdf-threads "$VDF_THREADS" --proof-threads "$PROOF_THREADS")
[ "$RETAIN_ASIC_VALUES" = "1" ] && cmd+=(--retain-asic-values)
cmd+=(
  --checkpoint-threshold "$CHECKPOINT_THRESHOLD"
  --vdfs-mask "$VDFS_MASK"
  --expected-serial "$SERIAL"
  --ip "$IP"
  "$PORT"
  "$N_VDFS"
)
# exec keeps hw_vdf_client as the launchd-tracked PID (SIGTERM goes straight to it).
exec "${cmd[@]}" > >("{{ chia_darwin_bin_dir }}/rotpipe.py" "$LOG" "{{ chia_darwin_rotpipe_max_bytes }}" "{{ chia_darwin_rotpipe_backups }}") 2>&1
