#!/bin/bash
# Managed by the chia-blockchain Ansible role.
# chia-watchdog: macOS equivalent of the Linux monit config for Chia timelords.
# Runs as root (needs launchctl kickstart). Installed root:wheel; never sources user-writable files.
#
# Mirrors monit on Linux (60s cycle):
#   /full_node  != 200 for FAIL_CYCLES  -> restart whole stack   (monit: progress_cycles = (480-300)/60)
#   /timelord   != 200 for FAIL_CYCLES  -> restart whole stack
#   /full_node/ports != 200 when enabled -> restart whole stack
#   ESTABLISHED conns to the VDF port != expected, or an hw-vdf job not running
#                                       -> restart every hw-vdf board
#   exporter ports not listening for FAIL_CYCLES -> kickstart that exporter job
# Timelord.app mode (chia_darwin_timelord_implementation: timelord-app):
#   supervisor /healthz or worker /healthz != 200 for FAIL_CYCLES
#                                       -> restart the app supervisor
#   chia-healthcheck /timelord is ignored; the app owns timelord progress.
#   On local topologies /full_node and /full_node/ports still come from
#   chia-healthcheck, and the full-node LaunchDaemon must be running.
# After DEBUG_THRESHOLD failed health checks, raise Chia to DEBUG via the RPC;
# restore the configured level when health recovers (like monit-set-log-level).
# If the healthcheck itself is down (no HTTP reply), only the healthcheck job is kickstarted.
# After the watchdog starts, wait the boot grace (default 3600s, matching
# monit's start delay) before counting failures. After a restart, wait the
# restart grace (default 600s) with no checks counted. Repeated failed restarts
# lengthen the restart grace (+300s each, capped at +900s) but the watchdog
# never gives up.
# No VDF-cliff / IPS-based triggers.
#
# Env overrides (for testing): WATCHDOG_DRY_RUN=1 (log only, no kickstart/alert), WATCHDOG_ONCE=1.

CYCLE=${WATCHDOG_CYCLE:-{{ chia_darwin_watchdog_cycle | int }}}
GRACE_BOOT=${WATCHDOG_BOOT_GRACE:-{{ chia_darwin_watchdog_grace | int }}}
GRACE_RESTART=${WATCHDOG_RESTART_GRACE:-{{ chia_darwin_watchdog_restart_grace | int }}}
FAIL_CYCLES={{ chia_darwin_watchdog_fail_cycles | int }}
DEBUG_THRESHOLD={{ chia_darwin_watchdog_log_debug_threshold | int }}
LOG_LEVEL={{ log_level }}
CHIA_BIN={{ chia_darwin_venv }}/bin/chia
CHIA_HOME={{ chia_darwin_home }}
CHIA_ROOT={{ chia_root }}
SUDO={{ chia_darwin_sudo }}
EXPECTED_VDFS="{{ chia_darwin_hw_vdf_jobs | selectattr('enabled', 'equalto', true) | map(attribute='board') | map(attribute='n_vdfs') | map('int') | sum }}"
VDF_PORT={{ chia_darwin_hw_vdf_port | int }}
HC=http://127.0.0.1:{{ chia_darwin_chia_healthcheck_port | int }}
PREFIX={{ chia_darwin_launchd_prefix }}
PLIST_DIR={{ chia_darwin_launchd_dir }}
ENABLE_ON_BOOT={{ 1 if chia_darwin_start_on_boot | bool else 0 }}
BOARD_STOP_TIMEOUT={{ chia_darwin_watchdog_board_stop_timeout | int }}
CONF_DIR={{ chia_darwin_watchdog_conf_dir }}
TOKEN_FILE=$CONF_DIR/alert-token
URL_FILE=$CONF_DIR/webhook-url
LOG=${WATCHDOG_LOG:-{{ chia_darwin_watchdog_log }}}
DRY=${WATCHDOG_DRY_RUN:-0}
HW_JOB_LIST="{{ chia_darwin_hw_vdf_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | join(' ') }}"
SERVICE_JOB_LIST="{{ chia_darwin_service_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | join(' ') }}"
read -r -a HW_JOBS <<<"$HW_JOB_LIST"
read -r -a SERVICE_JOBS <<<"$SERVICE_JOB_LIST"
CHECK_HEALTHCHECK="{{ 1 if 'chia-healthcheck' in chia_darwin_companion_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | list else 0 }}"
CHECK_FULL_NODE="{{ 1 if 'full-node' in chia_darwin_service_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | list else 0 }}"
CHECK_TIMELORD="{{ 1 if 'timelord' in chia_darwin_service_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | list else 0 }}"
CHECK_FULL_NODE_PORTS="{{ 1 if chia_darwin_watchdog_check_full_node_ports | bool and 'chia-healthcheck' in chia_darwin_companion_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | list and 'full-node' in chia_darwin_service_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | list else 0 }}"
CHECK_EXPORTER="{{ 1 if 'chia-exporter' in chia_darwin_companion_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | list else 0 }}"
CHECK_NODE="{{ 1 if 'node-exporter' in chia_darwin_companion_jobs | selectattr('enabled', 'equalto', true) | map(attribute='name') | list else 0 }}"
CHECK_APP="{{ 1 if chia_darwin_timelord_app_enabled | bool else 0 }}"
APP_LABEL={{ chia_darwin_timelord_app_service_label }}
APP_STATUS=http://127.0.0.1:{{ chia_darwin_timelord_app_status_port | int }}
APP_SUPERVISOR=http://{{ chia_darwin_timelord_app_supervisor_probe_host }}:{{ chia_darwin_timelord_app_supervisor_port | int }}
CHECK_FULL_NODE_JOB=$((CHECK_APP && CHECK_FULL_NODE))
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
# The ports probe is meaningless without a local full node.
[ "$CHECK_FULL_NODE" = 1 ] || CHECK_FULL_NODE_PORTS=0

log() {
	local ts
	ts=$(date '+%Y-%m-%dT%H:%M:%S%z')
	echo "$ts $*" >>"$LOG" 2>/dev/null || echo "$ts $*"
	if [ -f "$LOG" ] && [ "$(stat -f %z "$LOG" 2>/dev/null || echo 0)" -gt 5242880 ]; then
		mv -f "$LOG" "$LOG.1"
	fi
}

http_code_at() { curl -s -o /dev/null -m 10 -w '%{http_code}' "$1$2" 2>/dev/null; }

http_code() { http_code_at "$HC" "$1"; }

listening() { netstat -an -p tcp | grep -E "[.:]$1 .*LISTEN" >/dev/null; }

vdf_conns() { netstat -an -p tcp | awk -v p=".$VDF_PORT" '$6=="ESTABLISHED" && substr($5,length($5)-length(p)+1)==p' | wc -l | tr -d ' '; }

job_running() { launchctl print "system/$PREFIX.$1" 2>/dev/null | grep -q "state = running"; }

hw_jobs_running() {
	local j
	for j in "${HW_JOBS[@]}"; do
		job_running "$j" || return 1
	done
	return 0
}

alert() {
	local desc="$1" url payload
	[ "$DRY" = 1 ] && {
		log "DRY alert: $desc"
		return
	}
	[ -r "$TOKEN_FILE" ] && [ -r "$URL_FILE" ] || {
		log "alert skipped (no $TOKEN_FILE / $URL_FILE): $desc"
		return
	}
	url=$(head -n1 "$URL_FILE")
	payload="{\"alerts\":[{\"status\":\"warning\",\"annotations\":{\"title\":\"Monit Alert\",\"description\":\"$desc\"}}]}"
	# token goes to curl via stdin config so it never appears in argv, logs or ps
	code=$({
		printf 'header = "Authorization: Bearer '
		tr -d '\r\n' <"$TOKEN_FILE"
		printf '"\n'
	} |
		curl -s -o /dev/null -m 20 -w '%{http_code}' -K - -X POST -H 'Content-Type: application/json' -d "$payload" "$url" 2>/dev/null)
	log "alert sent, HTTP ${code:-none}"
}

chia_rpc_set_log_level() { # service level
	"$SUDO" -u "{{ user }}" env HOME="$CHIA_HOME" CHIA_ROOT="$CHIA_ROOT" \
		"$CHIA_BIN" rpc "$1" set_log_level "{\"level\":\"$2\"}"
}

set_log_level() { # DEBUG|INFO|configured level
	local level="$1"
	[ "$DRY" = 1 ] && {
		log "DRY set_log_level $level"
		return
	}
	if [ "$CHECK_FULL_NODE" = 1 ]; then
		chia_rpc_set_log_level full_node "$level" >>"$LOG" 2>&1 ||
			log "set_log_level full_node $level failed"
	fi
	if [ "$CHECK_TIMELORD" = 1 ]; then
		chia_rpc_set_log_level timelord "$level" >>"$LOG" 2>&1 ||
			log "set_log_level timelord $level failed"
	fi
}

kick() { # full label
	if [ "$DRY" = 1 ]; then
		log "DRY kickstart $1"
		return 0
	fi
	launchctl kickstart -k "system/$1" >>"$LOG" 2>&1 || log "kickstart $1 failed"
}

stop_board() { # label
	if [ "$DRY" = 1 ]; then
		log "DRY bootout $PREFIX.$1"
		return 0
	fi
	launchctl bootout "system/$PREFIX.$1" >>"$LOG" 2>&1 || true
	local n=0
	while launchctl print "system/$PREFIX.$1" >/dev/null 2>&1; do
		n=$((n + 1))
		if [ "$n" -ge "$BOARD_STOP_TIMEOUT" ]; then
			log "stop $1 still loaded after ${BOARD_STOP_TIMEOUT}s"
			return 1
		fi
		sleep 1
	done
	return 0
}

start_board() { # label
	if [ "$DRY" = 1 ]; then
		log "DRY bootstrap $PREFIX.$1"
		return 0
	fi
	if launchctl print "system/$PREFIX.$1" >/dev/null 2>&1; then
		log "bootstrap $1 skipped: still loaded"
		return 1
	fi
	if [ -f "$PLIST_DIR/$PREFIX.$1.plist" ]; then
		launchctl enable "system/$PREFIX.$1" >>"$LOG" 2>&1 ||
			log "enable $1 failed"
		launchctl bootstrap system "$PLIST_DIR/$PREFIX.$1.plist" >>"$LOG" 2>&1 ||
			log "bootstrap $1 failed"
		if [ "$ENABLE_ON_BOOT" = 0 ]; then
			launchctl disable "system/$PREFIX.$1" >>"$LOG" 2>&1 ||
				log "disable $1 failed"
		fi
	else
		log "bootstrap $1 skipped: missing $PLIST_DIR/$PREFIX.$1.plist"
	fi
}

restart_full() {
	local j
	log "RESTART full stack: $1"
	for j in "${HW_JOBS[@]}"; do
		stop_board "$j"
	done
	sleep 2
	for j in "${SERVICE_JOBS[@]}"; do
		kick "$PREFIX.$j"
		sleep 8
	done
	if [ "$CHECK_APP" = 1 ]; then
		kick "$APP_LABEL"
		sleep 8
	fi
	for j in "${HW_JOBS[@]}"; do
		start_board "$j"
		sleep 8
	done
}

restart_app() {
	log "RESTART Timelord.app: $1"
	kick "$APP_LABEL"
	sleep 8
}

restart_hwvdf() {
	local j
	log "RESTART hw-vdf boards: $1"
	for j in "${HW_JOBS[@]}"; do
		stop_board "$j"
	done
	sleep 2
	for j in "${HW_JOBS[@]}"; do
		start_board "$j"
		sleep 8
	done
}

fn_fail=0
tl_fail=0
fnp_fail=0
vdf_fail=0
ce_fail=0
hc_fail=0
ne_fail=0
app_sup_fail=0
app_worker_fail=0
fnj_fail=0
log_fail=0
debug_active=0
bad_restarts=0
healthy_run=0
grace_until=$(($(date +%s) + GRACE_BOOT))
log "watchdog start pid $$ (dry=$DRY) expected_vdfs=$EXPECTED_VDFS jobs=${HW_JOBS[*]}; initial grace ${GRACE_BOOT}s"
# A previous watchdog may have left Chia at DEBUG. Start from the configured
# level so a watchdog-only restart cannot leave DEBUG running indefinitely.
set_log_level "$LOG_LEVEL"

while :; do
	now=$(date +%s)
	if [ "$now" -lt "$grace_until" ]; then
		[ "$WATCHDOG_ONCE" = 1 ] && {
			log "in grace, ${grace_until}-${now}"
			exit 0
		}
		sleep "$CYCLE"
		continue
	fi

	fn=$(http_code /full_node)
	tl=$(http_code /timelord)
	if [ "$CHECK_FULL_NODE_PORTS" = 1 ]; then
		fnp=$(http_code /full_node/ports)
	else
		fnp=""
	fi
	vdf=$(vdf_conns)
	problems=""
	scope=""
	hc_down=0

	if [ "$CHECK_HEALTHCHECK" = 1 ]; then
		if [ "$tl" = "000" ]; then
			if [ "$CHECK_FULL_NODE" = 0 ] || [ "$fn" = "000" ]; then
				hc_down=1
			fi
		fi
		if [ "$hc_down" = 1 ]; then
			hc_fail=$((hc_fail + 1))
			fn_fail=0
			tl_fail=0
			fnp_fail=0
			log "healthcheck :{{ chia_darwin_chia_healthcheck_port | int }} unreachable ($hc_fail/$FAIL_CYCLES)"
			if [ $hc_fail -ge $FAIL_CYCLES ]; then
				kick "$PREFIX.chia-healthcheck"
				hc_fail=0
			fi
		else
			hc_fail=0
			if [ "$CHECK_FULL_NODE" = 1 ]; then
				if [ "$fn" = "200" ]; then
					fn_fail=0
				else
					fn_fail=$((fn_fail + 1))
					log "/full_node HTTP $fn ($fn_fail/$FAIL_CYCLES)"
				fi
			fi
			if [ "$CHECK_TIMELORD" = 1 ]; then
				if [ "$tl" = "200" ]; then
					tl_fail=0
				else
					tl_fail=$((tl_fail + 1))
					log "/timelord HTTP $tl ($tl_fail/$FAIL_CYCLES)"
				fi
			fi
			if [ "$CHECK_FULL_NODE_PORTS" = 1 ]; then
				if [ "$fnp" = "200" ]; then
					fnp_fail=0
				else
					fnp_fail=$((fnp_fail + 1))
					log "/full_node/ports HTTP $fnp ($fnp_fail/$FAIL_CYCLES)"
				fi
			fi
			if [ "$CHECK_FULL_NODE" = 1 ] && [ $fn_fail -ge $FAIL_CYCLES ]; then
				problems="$problems full_node-health"
				scope=full
			fi
			if [ "$CHECK_TIMELORD" = 1 ] && [ $tl_fail -ge $FAIL_CYCLES ]; then
				problems="$problems timelord-health"
				scope=full
			fi
			if [ "$CHECK_FULL_NODE_PORTS" = 1 ] && [ $fnp_fail -ge $FAIL_CYCLES ]; then
				problems="$problems full_node-ports"
				scope=full
			fi
		fi
	fi

	if [ "$CHECK_APP" = 1 ]; then
		app_sup=$(http_code_at "$APP_SUPERVISOR" /healthz)
		app_worker=$(http_code_at "$APP_STATUS" /healthz)
		if [ "$app_sup" = "200" ]; then
			app_sup_fail=0
		else
			app_sup_fail=$((app_sup_fail + 1))
			log "Timelord.app supervisor /healthz HTTP $app_sup ($app_sup_fail/$FAIL_CYCLES)"
		fi
		if [ "$app_sup" = "200" ] && [ "$app_worker" = "200" ]; then
			app_worker_fail=0
		else
			app_worker_fail=$((app_worker_fail + 1))
			log "Timelord.app worker /healthz HTTP $app_worker ($app_worker_fail/$FAIL_CYCLES)"
		fi
		if [ $app_sup_fail -ge $FAIL_CYCLES ] || [ $app_worker_fail -ge $FAIL_CYCLES ]; then
			problems="$problems timelord-app-health"
			[ -z "$scope" ] && scope=app
		fi
	fi

	if [ "$CHECK_FULL_NODE_JOB" = 1 ]; then
		if job_running full-node; then
			fnj_fail=0
		else
			fnj_fail=$((fnj_fail + 1))
			log "full-node LaunchDaemon is not running ($fnj_fail/$FAIL_CYCLES)"
		fi
		if [ $fnj_fail -ge $FAIL_CYCLES ]; then
			problems="$problems full_node-job"
			scope=full
		fi
	fi

	# Mirror the Linux monit log-level escalation: raise to DEBUG after a short
	# health failure, then restore the configured level when the healthcheck
	# succeeds again. Do not escalate while the healthcheck itself is down.
	if [ "$CHECK_HEALTHCHECK" = 1 ] && [ "$hc_down" = 0 ]; then
		if { [ "$CHECK_FULL_NODE" = 1 ] && [ "$fn" != "200" ]; } ||
			{ [ "$CHECK_TIMELORD" = 1 ] && [ "$tl" != "200" ]; }; then
			log_fail=$((log_fail + 1))
			if [ $log_fail -ge $DEBUG_THRESHOLD ] && [ "$debug_active" = 0 ]; then
				set_log_level DEBUG
				debug_active=1
				log "log level raised to DEBUG after $log_fail failed health checks"
			fi
		else
			log_fail=0
			if [ "$debug_active" = 1 ]; then
				set_log_level "$LOG_LEVEL"
				debug_active=0
				log "log level restored to $LOG_LEVEL"
			fi
		fi
	fi

	if [ -n "$HW_JOB_LIST" ] && ! hw_jobs_running; then
		vdf_fail=$((vdf_fail + 1))
		log "hw-vdf: a board job is not running ($vdf_fail/$FAIL_CYCLES)"
	elif [ "$EXPECTED_VDFS" -gt 0 ] && [ "$vdf" != "$EXPECTED_VDFS" ]; then
		vdf_fail=$((vdf_fail + 1))
		log "hw-vdf: established=$vdf (want $EXPECTED_VDFS) ($vdf_fail/$FAIL_CYCLES)"
	else
		vdf_fail=0
	fi
	if [ $vdf_fail -ge $FAIL_CYCLES ]; then
		problems="$problems hw-vdf-asics"
		[ -z "$scope" ] && scope=hwvdf
	fi

	if [ "$CHECK_EXPORTER" = 1 ]; then
		if listening {{ chia_darwin_chia_exporter_port | int }}; then ce_fail=0; else ce_fail=$((ce_fail + 1)); fi
		if [ $ce_fail -ge $FAIL_CYCLES ]; then
			log "chia-exporter :{{ chia_darwin_chia_exporter_port | int }} not listening"
			kick "$PREFIX.chia-exporter"
			ce_fail=0
		fi
	fi
	if [ "$CHECK_NODE" = 1 ]; then
		if listening {{ chia_darwin_node_exporter_port | int }}; then ne_fail=0; else ne_fail=$((ne_fail + 1)); fi
		if [ $ne_fail -ge $FAIL_CYCLES ]; then
			log "node-exporter :{{ chia_darwin_node_exporter_port | int }} not listening"
			kick "$PREFIX.node-exporter"
			ne_fail=0
		fi
	fi

	if [ -n "$problems" ]; then
		bad_restarts=$((bad_restarts + 1))
		healthy_run=0
		if [ "$scope" = full ]; then
			restart_full "$problems"
			# The restarted processes use the configured level, so allow DEBUG
			# to be raised again if the node is still unhealthy.
			debug_active=0
		elif [ "$scope" = app ]; then
			restart_app "$problems"
		else
			restart_hwvdf "$problems"
		fi
		alert "Watchdog restarted the Chia timelord services ($scope:$problems) on host $(hostname -s)"
		fn_fail=0
		tl_fail=0
		fnp_fail=0
		log_fail=0
		vdf_fail=0
		app_sup_fail=0
		app_worker_fail=0
		fnj_fail=0
		extra=$(((bad_restarts - 1) * 300))
		[ $extra -gt 900 ] && extra=900
		grace_until=$(($(date +%s) + GRACE_RESTART + extra))
		log "grace until +$((GRACE_RESTART + extra))s (consecutive restarts: $bad_restarts)"
	else
		healthy_run=$((healthy_run + 1))
		if [ $healthy_run -ge 5 ] && [ $bad_restarts -ne 0 ]; then
			bad_restarts=0
			log "healthy for 5 cycles; restart backoff reset"
		fi
		[ $((healthy_run % 30)) -eq 1 ] && log "ok fn=$fn fnp=$fnp tl=$tl vdf=$vdf app_sup=${app_sup:-n/a} app_worker=${app_worker:-n/a}"
	fi
	[ "$WATCHDOG_ONCE" = 1 ] && {
		log "once: fn=$fn fnp=$fnp tl=$tl vdf=$vdf problems='$problems'"
		exit 0
	}
	sleep "$CYCLE"
done
