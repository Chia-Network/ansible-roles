#!/bin/zsh
# Managed by the chia-blockchain Ansible role.
. {{ chia_darwin_env_script | quote }}
wait_for_listen {{ chia_daemon_port | quote }} # chia daemon
LAUNCHER_PORT={{ chia_timelord_launcher_port | quote }}
PEER_HOST={{ chia_timelord_full_node_peer_host | quote }}
FULL_NODE_PORT={{ full_node_port | quote }}
log "starting chia_timelord (vdf_server on :$LAUNCHER_PORT, full node peer $PEER_HOST:$FULL_NODE_PORT)"
exec {{ chia_darwin_venv | quote }}/bin/chia_timelord
