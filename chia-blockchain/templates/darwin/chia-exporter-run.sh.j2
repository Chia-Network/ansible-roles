#!/bin/zsh
# Managed by the chia-blockchain Ansible role.
# Mirrors the Linux chia-exporter unit: CHIA_ROOT and the daemon dependency.
. {{ chia_darwin_env_script | quote }}
export CHIA_ROOT={{ chia_darwin_companion_chia_root | quote }}
wait_for_db_volume
wait_for_listen {{ chia_daemon_port | quote }}
LOG={{ chia_darwin_log_dir | quote }}/chia-exporter.log
log "starting chia-exporter (CHIA_ROOT=$CHIA_ROOT)" >> "$LOG"
exec {{ chia_darwin_companion_bin_dir | quote }}/chia-exporter serve --metrics-port {{ chia_darwin_chia_exporter_port | int }} > >({{ chia_darwin_bin_dir | quote }}/rotpipe.py "$LOG" {{ chia_darwin_companion_rotpipe_max_bytes | quote }} {{ chia_darwin_companion_rotpipe_backups | quote }}) 2>&1
