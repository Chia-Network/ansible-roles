<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    PPPC (Privacy Preferences Policy Control) template.
    This role writes the file and stops. It does not run `profiles`, does not
    edit TCC.db, and does not toggle Full Disk Access.

    On modern macOS a SystemPolicyAllFiles grant is applied only when the
    profile is delivered by MDM (user-approved MDM or Automated Device
    Enrollment). Opening this file in System Settings does not grant access.

    The LaunchDaemon wrappers are {{ chia_darwin_interpreter | e }} scripts. TCC
    attributes their file access to that interpreter, so the identifier is the
    interpreter path, not the script path. This profile grants only
    {{ chia_darwin_interpreter | e }}. For local-external, Full Disk Access is
    also needed for the full node's Python interpreter. The Python path is the
    real Homebrew Cellar binary the venv resolves to; it is printed in the
    sibling FULL-DISK-ACCESS.txt note and must be added by hand in System
    Settings, and again after every Homebrew Python upgrade. Do not add a
    second identifier for that versioned Cellar path here because a Homebrew
    Python upgrade changes it. CHIA_ROOT and the companion services stay
    on the internal disk, so companion binaries, tailscaled, hw-vdf, the
    watchdog, Bash, and healthcheck are not added to this profile. Granting Full
    Disk Access to {{ chia_darwin_interpreter | e }} is still broad: other jobs
    that start via the same interpreter inherit it.
  -->
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadDescription</key>
      <string>Full Disk Access for the shared Chia timelord LaunchDaemon interpreter ({{ chia_darwin_interpreter | e }}).</string>
      <key>PayloadDisplayName</key>
      <string>Chia timelord Full Disk Access</string>
      <key>PayloadIdentifier</key>
      <string>{{ chia_darwin_pppc_identifier | e }}.payload</string>
      <key>PayloadType</key>
      <string>com.apple.TCC.configuration-profile-policy</string>
      <key>PayloadUUID</key>
      <string>{{ chia_darwin_pppc_payload_uuid | e }}</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>Services</key>
      <dict>
        <key>SystemPolicyAllFiles</key>
        <array>
          <dict>
            <key>Allowed</key>
            <true/>
            <key>CodeRequirement</key>
            <string>{{ chia_darwin_pppc_code_requirement | e }}</string>
            <key>Comment</key>
            <string>Shared shebang interpreter for the Chia job wrappers, including the full-node LaunchDaemon that reads the external blockchain DB directory.</string>
            <key>Identifier</key>
            <string>{{ chia_darwin_interpreter | e }}</string>
            <key>IdentifierType</key>
            <string>path</string>
            <key>StaticCode</key>
            <false/>
          </dict>
        </array>
      </dict>
    </dict>
  </array>
  <key>PayloadDescription</key>
  <string>MDM profile so the shared Chia job interpreter can read the external blockchain DB directory. Do not install by double-click. Does not modify TCC.db.</string>
  <key>PayloadDisplayName</key>
  <string>Chia timelord Full Disk Access</string>
  <key>PayloadIdentifier</key>
  <string>{{ chia_darwin_pppc_identifier | e }}</string>
  <key>PayloadOrganization</key>
  <string>Chia Network</string>
  <key>PayloadRemovalDisallowed</key>
  <false/>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>{{ chia_darwin_pppc_profile_uuid | e }}</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
