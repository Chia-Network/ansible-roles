#!/bin/zsh
# Managed by the chia-blockchain Ansible role.
# Mirrors the Linux node-exporter unit: run as the service user on :9100.
. {{ chia_darwin_env_script | quote }}
log "starting node_exporter (listen :{{ chia_darwin_node_exporter_port | int }})"
exec {{ chia_darwin_companion_bin_dir | quote }}/node_exporter --web.listen-address=:{{ chia_darwin_node_exporter_port | int }}
