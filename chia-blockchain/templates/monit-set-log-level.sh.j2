#!/bin/bash
# Usage: monit-set-log-level.sh DEBUG|INFO
set -o pipefail

LEVEL="${1:?usage: $0 DEBUG|INFO}"
case "${LEVEL}" in
DEBUG | INFO) ;;
*)
	echo "invalid log level: ${LEVEL}" >&2
	exit 1
	;;
esac

CHIA_PATH="/home/{{ user }}/chia-blockchain"

if [ -d "$CHIA_PATH" ]; then
	echo "Found $CHIA_PATH — activating environment..."
	. "$CHIA_PATH/activate"
else
	echo "$CHIA_PATH not found — Chia is installed with apt. Continuing...."
fi

chia rpc full_node set_log_level "{ \"level\": \"${LEVEL}\" }"
chia rpc timelord set_log_level "{ \"level\": \"${LEVEL}\" }"
echo "Log level set to ${LEVEL}"
